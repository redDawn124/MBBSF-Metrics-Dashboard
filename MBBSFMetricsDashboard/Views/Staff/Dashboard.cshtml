@{
    ViewData["Title"] = "Board Member Dashboard";
    ViewData["CanEdit"] = false;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Board Member Dashboard</h1>
        <p class="text-body-secondary mb-1">Welcome, @User.Identity?.Name.</p>
        <p class="text-body-secondary mb-0">
            You have view-only access. Dashboard editing and database management are available to administrators.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary">Change Password</a>
        <form asp-controller="Staff" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">Logout</button>
        </form>
    </div>
</div>

<partial name="_MetricsTabs" />

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/dashboard-tabs.js" asp-append-version="true"></script>
}
