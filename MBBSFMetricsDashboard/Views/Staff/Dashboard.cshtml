@{
    ViewData["Title"] = "Board Member Dashboard";
}
<h1>Board Member Dashboard</h1>
<p>Welcome, @User.Identity?.Name.</p>
<p>You have view-only access. Dashboard editing and database management are available to administrators.</p>
<div class="alert alert-info" role="status">
    Your login is working. Scholarship, Coursera, and mentoring metrics will appear here when the dashboard is connected.
</div>

<form asp-controller="Staff" asp-action="Logout" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-secondary">Logout</button>
</form>
