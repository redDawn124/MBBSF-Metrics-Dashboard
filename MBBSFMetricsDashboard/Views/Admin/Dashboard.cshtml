@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["CanEdit"] = true;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Admin Dashboard</h1>
        <p class="text-body-secondary mb-0">
            Metrics by source. Administrators can import and edit data.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary">Manage Accounts</a>
        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary">Change Password</a>
        <form asp-controller="Admin" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">Logout</button>
        </form>
    </div>
</div>

<partial name="_MetricsTabs" />

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/dashboard-tabs.js" asp-append-version="true"></script>
}
