@model DashboardViewModel

<div class="metrics-tabs">
    <ul class="nav nav-tabs nav-fill" id="metricsTabs" role="tablist">
        @for (var i = 0; i < Model.Sources.Count; i++)
        {
            var source = Model.Sources[i];
            var isActive = i == 0;
            <li class="nav-item" role="presentation">
                <button class="nav-link @(isActive ? "active" : null)" id="@(source.Id)-tab" type="button" role="tab"
                        data-bs-toggle="tab" data-bs-target="#@(source.Id)-pane"
                        aria-controls="@(source.Id)-pane" aria-selected="@(isActive ? "true" : "false")">
                    @source.Name
                </button>
            </li>
        }
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom bg-white p-3" id="metricsTabContent">
        @for (var i = 0; i < Model.Sources.Count; i++)
        {
            var source = Model.Sources[i];
            var isActive = i == 0;
            <div class="tab-pane fade @(isActive ? "show active" : null)" id="@(source.Id)-pane" role="tabpanel"
                 aria-labelledby="@(source.Id)-tab" tabindex="0">
                <div id="@source.Id-dashboard-view">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (Model.CanEdit)
                        {
                            <button type="button" class="btn btn-outline-secondary" data-filter-open
                                    aria-controls="@source.Id-filter-panel" aria-expanded="false">
                                Filter By
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary">Filter Data</button>
                        }
                        <button type="button" class="btn btn-outline-secondary" data-summary-open
                                aria-controls="@source.Id-summary-panel" aria-expanded="false">
                            Summarize Data
                        </button>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-7">
                            <partial name="_MetricTable" model="source" />
                        </div>
                        <div class="col-lg-5">
                            <partial name="_MetricChart" model="source" />
                        </div>
                    </div>

                    
                </div>

                @if (Model.CanEdit && source.FilterKind == DashboardFilterKind.Coursera)
                {
                    <partial name="Filters/_CourseraFilter" model="source" />
                }

                @if (Model.CanEdit && source.FilterKind == DashboardFilterKind.GoogleForms)
                {
                    <partial name="Filters/_GoogleFormsFilter" model="source" />
                }

                @if (Model.CanEdit && source.FilterKind == DashboardFilterKind.Cognito)
                {
                    <partial name="Filters/_CognitoFilter" model="source" />
                }

                <partial name="_DashboardSummary" model="source" />
            </div>
        }
    </div>
</div>

<div class="modal fade" id="chartExpandModal" tabindex="-1" aria-labelledby="chartExpandModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="chartExpandModalLabel">Chart</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="metrics-chart-expanded">
                    <canvas id="chartExpandModalCanvas"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
