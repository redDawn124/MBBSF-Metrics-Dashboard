@{
    var canEdit = ViewData["CanEdit"] as bool? ?? false;
    var sources = new[]
    {
        new { Name = "Coursera", Id = "coursera" },
        new { Name = "Google Forms", Id = "google-forms" },
        new { Name = "Cognito", Id = "cognito" }
    };
    var floridaCounties = new[]
    {
        "Alachua", "Baker", "Bay", "Bradford", "Brevard", "Broward", "Calhoun", "Charlotte", "Citrus", "Clay",
        "Collier", "Columbia", "DeSoto", "Dixie", "Duval", "Escambia", "Flagler", "Franklin", "Gadsden", "Gilchrist",
        "Glades", "Gulf", "Hamilton", "Hardee", "Hendry", "Hernando", "Highlands", "Hillsborough", "Holmes", "Indian River",
        "Jackson", "Jefferson", "Lafayette", "Lake", "Lee", "Leon", "Levy", "Liberty", "Madison", "Manatee",
        "Marion", "Martin", "Miami-Dade", "Monroe", "Nassau", "Okaloosa", "Okeechobee", "Orange", "Osceola", "Palm Beach",
        "Pasco", "Pinellas", "Polk", "Putnam", "St. Johns", "St. Lucie", "Santa Rosa", "Sarasota", "Seminole", "Sumter",
        "Suwannee", "Taylor", "Union", "Volusia", "Wakulla", "Walton", "Washington"
    };
}

<div class="metrics-tabs">
    <ul class="nav nav-tabs nav-fill" id="metricsTabs" role="tablist">
        @for (var i = 0; i < sources.Length; i++)
        {
            var source = sources[i];
            var isActive = i == 0;
            <li class="nav-item" role="presentation">
                <button class="nav-link @(isActive ? "active" : null)" id="@(source.Id)-tab" type="button" role="tab"
                        data-bs-toggle="tab" data-bs-target="#@(source.Id)-pane"
                        aria-controls="@(source.Id)-pane" aria-selected="@(isActive ? "true" : "false")">
                    @source.Name
                </button>
            </li>
        }
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom bg-white p-3" id="metricsTabContent">
        @for (var i = 0; i < sources.Length; i++)
        {
            var source = sources[i];
            var isActive = i == 0;
            <div class="tab-pane fade @(isActive ? "show active" : null)" id="@(source.Id)-pane" role="tabpanel"
                 aria-labelledby="@(source.Id)-tab" tabindex="0">
                <div id="@source.Id-dashboard-view">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (canEdit && (source.Id == "coursera" || source.Id == "google-forms" || source.Id == "cognito"))
                        {
                            <button type="button" class="btn btn-outline-secondary" data-filter-open
                                    aria-controls="@source.Id-filter-panel" aria-expanded="false">
                                Filter By
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary">Filter Data</button>
                        }
                        <button type="button" class="btn btn-outline-secondary">Summarize Data</button>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-7">
                            <section class="metrics-panel h-100">
                                <h2 class="metrics-panel-title">Data</h2>
                                <div class="metrics-table-shell" aria-label="@source.Name data table">
                                    <p class="text-body-secondary small mb-0">No data uploaded yet.</p>
                                </div>
                            </section>
                        </div>
                        <div class="col-lg-5">
                            <section class="metrics-panel h-100">
                                <h2 class="metrics-panel-title">Visual data</h2>
                                <div class="metrics-visual-shell" aria-label="@source.Name visual data">
                                    <p class="text-body-secondary small mb-0">Visualization will appear here.</p>
                                </div>
                            </section>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        @if (canEdit)
                        {
                            <button type="button" class="btn btn-primary" disabled
                                    title="File upload is not available yet">
                                Upload data
                            </button>
                        }
                        else
                        {
                            <p class="small text-body-secondary mb-0">Ask an administrator to upload data.</p>
                        }
                    </div>
                </div>

                @if (canEdit && source.Id == "coursera")
                {
                    <section class="dashboard-filter-panel coursera-filter-panel" id="coursera-filter-panel" aria-labelledby="coursera-filter-title" hidden>
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
                            <h2 class="coursera-filter-title mb-0" id="coursera-filter-title">Filter Coursera Data By:</h2>
                            <span class="coursera-filter-badge">Illustrative selections</span>
                        </div>

                        <fieldset class="coursera-filter-options">
                            <legend class="visually-hidden">Choose how to filter Coursera data</legend>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="coursera-filter" value="student-name-ascending" checked />
                                <span class="form-check-label">Student Name (A–Z)</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="coursera-filter" value="course-name-ascending" />
                                <span class="form-check-label">Course Name (A–Z)</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="coursera-filter" value="total-hours-ascending" />
                                <span class="form-check-label">Total Hours (Ascending)</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="coursera-filter" value="total-hours-descending" />
                                <span class="form-check-label">Total Hours (Descending)</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="coursera-filter" value="completion-ascending" />
                                <span class="form-check-label">Completion % (Ascending)</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="coursera-filter" value="completion-descending" />
                                <span class="form-check-label">Completion % (Descending)</span>
                            </label>
                        </fieldset>

                        <div class="coursera-filter-actions d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary" data-filter-close>Apply Filter</button>
                            <button type="button" class="btn btn-outline-secondary" data-filter-close>Cancel</button>
                        </div>
                    </section>
                }

                @if (canEdit && source.Id == "google-forms")
                {
                    <section class="dashboard-filter-panel google-forms-filter-panel" id="google-forms-filter-panel" aria-labelledby="google-forms-filter-title" hidden>
                        <h2 class="google-forms-filter-title" id="google-forms-filter-title">Filter Google Forms data by</h2>

                        <div class="google-forms-filter-fields">
                            <div class="google-forms-filter-field">
                                <label class="form-label" for="google-forms-mentor">Mentor</label>
                                <select class="form-select" id="google-forms-mentor">
                                    <option value="">All mentors</option>
                                    <option value="mentor-1">Mentor 1</option>
                                    <option value="mentor-2">Mentor 2</option>
                                    <option value="mentor-3">Mentor 3</option>
                                    <option value="mentor-4">Mentor 4</option>
                                    <option value="mentor-5">Mentor 5</option>
                                </select>
                            </div>

                            <div class="google-forms-filter-field">
                                <label class="form-label" for="google-forms-communication-method">Communication method</label>
                                <select class="form-select" id="google-forms-communication-method">
                                    <option value="">All methods</option>
                                    <option value="text-message">Text message</option>
                                    <option value="email">Email</option>
                                    <option value="in-person">In-person</option>
                                </select>
                            </div>

                            <div class="google-forms-filter-field">
                                <label class="form-label" for="google-forms-frequency">Frequency</label>
                                <input class="form-control" id="google-forms-frequency" type="number" min="0" step="1" placeholder="Enter amount" />
                            </div>
                        </div>

                        <div class="google-forms-filter-actions d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary" data-filter-close>Apply filter</button>
                            <button type="button" class="btn btn-outline-secondary" data-filter-clear>Clear</button>
                            <button type="button" class="btn btn-outline-secondary" data-filter-close>Cancel</button>
                        </div>
                    </section>
                }

                @if (canEdit && source.Id == "cognito")
                {
                    <section class="dashboard-filter-panel cognito-filter-panel" id="cognito-filter-panel" aria-labelledby="cognito-filter-title" hidden>
                        <h2 class="google-forms-filter-title" id="cognito-filter-title">Filter Cognito data by</h2>

                        <div class="cognito-filter-fields">
                            <div class="google-forms-filter-field cognito-county-field">
                                <label class="form-label" for="cognito-county">County</label>
                                <select class="form-select" id="cognito-county" data-cognito-county>
                                    <option value="">Select county</option>
                                    @foreach (var county in floridaCounties)
                                    {
                                        <option value="@county">@county County</option>
                                    }
                                </select>
                            </div>

                            <div class="google-forms-filter-field cognito-school-field" id="cognito-school-field" data-cognito-school-field hidden>
                                <label class="form-label" for="cognito-school">School</label>
                                <select class="form-select" id="cognito-school">
                                    <option value="">Schools in county</option>
                                    <option value="school-placeholder-1">High school placeholder 1</option>
                                    <option value="school-placeholder-2">High school placeholder 2</option>
                                    <option value="school-placeholder-3">High school placeholder 3</option>
                                    <option value="school-placeholder-4">High school placeholder 4</option>
                                    <option value="school-placeholder-5">High school placeholder 5</option>
                                </select>
                                <small class="form-text">Placeholder school options will be replaced with the selected county's high schools.</small>
                            </div>

                            <div class="google-forms-filter-field cognito-major-field">
                                <label class="form-label" for="cognito-major">Intended major</label>
                                <select class="form-select" id="cognito-major">
                                    <option value="">Select major</option>
                                    <option>Accounting</option>
                                    <option>Biology</option>
                                    <option>Business</option>
                                    <option>Computer Science</option>
                                    <option>Education</option>
                                    <option>Engineering</option>
                                    <option>Health Sciences</option>
                                    <option>Nursing</option>
                                    <option>Psychology</option>
                                    <option>Undecided</option>
                                </select>
                            </div>
                        </div>

                        <div class="google-forms-filter-actions d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary" data-filter-close>Apply filter</button>
                            <button type="button" class="btn btn-outline-secondary" data-cognito-filter-clear>Clear</button>
                            <button type="button" class="btn btn-outline-secondary" data-filter-close>Cancel</button>
                        </div>
                    </section>
                }
            </div>
        }
    </div>
</div>
