@model MBBSFMetricsDashboard.Services.AccountInfo
@{
    ViewData["Title"] = "Delete Staff Account";
}
<h1>Delete Staff Account</h1>
<p>Are you sure you want to delete this staff account?</p>
<dl class="row">
    <dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.FullName</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Role</dt><dd class="col-sm-10">Staff</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete Account</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
